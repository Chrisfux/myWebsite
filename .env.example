# ──────────────────────────────────────────────
# ÖFFENTLICHE VARIABLEN (dürfen im Frontend sein)
# ──────────────────────────────────────────────
# Supabase Projekt-URL und anonymer Public-Key.
# Diese Werte sind für den clientseitigen Gebrauch bestimmt.
# Zu finden im Supabase Dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────
# GEHEIME VARIABLEN (NIEMALS im Frontend nutzen!)
# ──────────────────────────────────────────────
# Supabase Service Role Key – nur serverseitig.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend API Key für E-Mail-Versand.
RESEND_API_KEY=re_xxxxxxxxxxxx

# ──────────────────────────────────────────────
# WEITERE KONFIGURATION
# ──────────────────────────────────────────────
RESEND_FROM_EMAIL=noreply@deine-domain.de
RESEND_FROM_NAME=Christian Fuchs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
